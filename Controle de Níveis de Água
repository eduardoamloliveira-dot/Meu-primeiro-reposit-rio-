# 1. Lista que armazena os níveis e suas respectivas configurações
# Cada nível é representado por um dicionário com a situação e a cor correspondente
NIVEIS_RESERVATORIO = [
    {"nivel": 1, "situacao": "Muito baixo (crítico)", "cor": Fore.RED},
    {"nivel": 2, "situacao": "Baixo", "cor": Fore.YELLOW},
    {"nivel": 3, "situacao": "Médio", "cor": Fore.GREEN},
    {"nivel": 4, "situacao": "Alto", "cor": Fore.CYAN},
    {"nivel": 5, "situacao": "Muito alto (alerta)", "cor": Fore.BLUE},
]


def exibir_alerta(nivel_atual: int):
    """
    Função responsável por identificar o nível informado,
    definir a cor correspondente e exibir a mensagem no terminal.
    """
    # Busca o nível correspondente dentro da lista
    alerta_encontrado = None
    for item in NIVEIS_RESERVATORIO:
        if item["nivel"] == nivel_atual:
            alerta_encontrado = item
            break

    # Se o nível for válido, exibe a mensagem formatada
    if alerta_encontrado:
        cor = alerta_encontrado["cor"]
        situacao = alerta_encontrado["situacao"]
        
        # Exibe a mensagem com a cor definida e restaura o padrão ao final (Style.RESET_ALL)
        print(f"Status do Reservatório: Nível {nivel_atual} -> {cor}{situacao}{Style.RESET_ALL}")
    else:
        print(f"{Fore.WHITE}Nível {nivel_atual} inválido para o sistema.{Style.RESET_ALL}")


def simular_sistema():
    """
    Função principal que simula o ambiente real de monitoramento,
    percorrendo os níveis de água do reservatório.
    """
    print("=" * 50)
    print("  SISTEMA DE MONITORAMENTO DE NÍVEL DE ÁGUA  ")
    print("=" * 50)
    
    # Simulação automática passando por todos os níveis da lista
    for item in NIVEIS_RESERVATORIO:
        exibir_alerta(item["nivel"])
        time.sleep(1)  # Pequena pausa de 1 segundo para simular o monitoramento em tempo real

    print("=" * 50)
    print("Monitoramento finalizado.")


# Executa a simulação
if __name__ == "__main__":
    simular_sistema()
